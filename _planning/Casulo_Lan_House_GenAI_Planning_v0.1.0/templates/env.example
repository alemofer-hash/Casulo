CASULO_ENV=development
# Replace only after identifying the approved private-LAN address.
CASULO_GATEWAY_HOST=CHANGE_TO_APPROVED_LAN_IP
CASULO_GATEWAY_PORT=8443
CASULO_LLM_BASE_URL=http://127.0.0.1:8081
CASULO_ASR_BASE_URL=http://127.0.0.1:8082
CASULO_TTS_BASE_URL=http://127.0.0.1:8083
CASULO_WORKER_BASE_URL=http://127.0.0.1:8084
CASULO_MAX_ACTIVE_GENERATIONS=1
CASULO_DEFAULT_CONTEXT_TOKENS=8192
CASULO_MIN_FREE_DISK_GB=30
CASULO_RAW_AUDIO_RETENTION=false

# Secrets are deliberately absent. Generate them locally and store outside Git.
