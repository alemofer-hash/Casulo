{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casulo://schemas/memory-event/1.0",
  "title": "Casulo Memory Event 1.0",
  "type": "object",
  "required": ["schema", "event_id", "project_id", "kind", "payload", "source_ids", "occurred_at", "previous_hash", "event_hash"],
  "properties": {
    "schema": {"const": "casulo.memory-event/1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "occurred_at": {"type": "string", "minLength": 1},
    "previous_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
