{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "casulo://schemas/requirement-graph/1.0",
  "title": "Casulo Requirement Graph 1.0",
  "type": "object",
  "required": ["schema", "requirements", "dependencies", "source_event_ids"],
  "properties": {
    "schema": {"const": "casulo.requirement-graph/1.0"},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "dependencies": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "source_event_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
