# Telemetria HWiNFO é um fluxo mutável; as sessões imutáveis preservam as
# observações usadas pelo juiz. O arquivo bruto permanece local.
benchmarks/results/**/hwinfo-live*.CSV

# Diagnóstico inicial legado com sidecar divergente, preservado localmente e
# explicitamente excluído da cadeia de evidência aceita.
benchmarks/results/2026-07-31-thermal-covenant/doctor-canonical-v0.json
benchmarks/results/2026-07-31-thermal-covenant/doctor-canonical-v0.json.sha256

# Cópia intermediária válida, mas retida por um handle do filesystem antes de
# entrar no Git. A cópia final selada é a autoridade da ablação.
